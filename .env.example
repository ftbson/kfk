# KFK (KUN FAYA KUN) — Environment Configuration
# Copy this file to .env.local and fill in your values

# ==========================================
# DATABASE (Turso / libSQL)
# ==========================================
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# ==========================================
# AUTHENTICATION
# ==========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-32-char-base64-secret-here

# Admin credentials (hashed passwords recommended for production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your-bcrypt-hash-here

# ==========================================
# SITE CONFIGURATION
# ==========================================
NEXT_PUBLIC_SITE_URL=https://kunfayakun.com
NEXT_PUBLIC_SITE_NAME=KFK
NEXT_PUBLIC_SITE_DESCRIPTION="THE LIFESTYLE BRAND — Premium Men's Fashion, Accessories & Fragrances"

# ==========================================
# EMAIL (Nodemailer / SMTP)
# ==========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM="KFK <no-reply@kunfayakun.com>"
EMAIL_TO_ORDERS=orders@kunfayakun.com
EMAIL_TO_CONTACT=contact@kunfayakun.com

# ==========================================
# PROMO BAR (Configurable via env)
# ==========================================
# Set to "true" to enable the promo bar
NEXT_PUBLIC_PROMO_ENABLED=false
# Promo bar text (shown when enabled)
NEXT_PUBLIC_PROMO_TEXT="Free worldwide shipping on orders over $300"
# Promo bar end date (ISO 8601) — bar auto-hides after this date
NEXT_PUBLIC_PROMO_END_DATE=2026-12-31T23:59:59Z
# Optional CTA for promo bar
NEXT_PUBLIC_PROMO_CTA_TEXT=Shop Now
NEXT_PUBLIC_PROMO_CTA_HREF=/packs

# ==========================================
# SOCIAL MEDIA (Footer links)
# ==========================================
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/kunfayakun
NEXT_PUBLIC_SOCIAL_TWITTER=https://twitter.com/kunfayakun
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/kunfayakun
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@kunfayakun
NEXT_PUBLIC_SOCIAL_TIKTOK=https://tiktok.com/@kunfayakun
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/kunfayakun

# ==========================================
# CONTACT INFORMATION
# ==========================================
NEXT_PUBLIC_CONTACT_EMAIL=contact@kunfayakun.com
NEXT_PUBLIC_CONTACT_WHATSAPP=+229XXXXXXXXX
NEXT_PUBLIC_CONTACT_ADDRESS="KFK Headquarters, Cotonou, Benin"

# ==========================================
# LEGAL PLACEHOLDERS (Replace before launch)
# ==========================================
NEXT_PUBLIC_COMPANY_NAME="KFK (KUN FAYA KUN) SAS"
NEXT_PUBLIC_COMPANY_REGISTRY="RCCM: [TO BE COMPLETED]"
NEXT_PUBLIC_COMPANY_TAX_ID="Tax ID: [TO BE COMPLETED]"
NEXT_PUBLIC_COMPANY_ADDRESS="[TO BE COMPLETED]"
NEXT_PUBLIC_COMPANY_DIRECTOR="[TO BE COMPLETED]"
NEXT_PUBLIC_COMPANY_EMAIL="[TO BE COMPLETED]"
NEXT_PUBLIC_COMPANY_PHONE="[TO BE COMPLETED]"